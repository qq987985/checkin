# 管理页面登录账号和密码，不是签到网站的账号密码。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Lucky 使用 HTTPS 反代时保持 true；仅在本机 HTTP 测试时改成 false。
COOKIE_SECURE=true
# 建议填写实际公网域名（不带路径与末尾斜杠）。
PUBLIC_URL=

# Lucky 在同一宿主机运行：保留 127.0.0.1。
# Lucky 在另一设备/桥接容器中：填写部署主机可达的内网 IP，并限制端口仅允许 Lucky 访问。
BIND_ADDRESS=127.0.0.1
WEB_PORT=8505

# Cookie、签到 Token、签到地址、时间、次数均在登录后的网页填写。
